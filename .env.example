# Copy to .env for local development. Do NOT commit .env - it is gitignored.
# In production these are set as Portainer stack environment variables instead
# (with the ABH_ prefix - see docker-compose.portainer.yml).

# --- Required ---
TOKEN=your-discord-bot-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Signs session cookies and userscript API tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET=

# --- Paths (compose.yml sets these; listed here for standalone runs) ---
CONFIG_PATH=./configs
SQLITE_PATH=./artbot.db

# --- Integrations ---
PIXIV_COOKIE=
HF_TOKEN=

# --- Optional ---
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
TASK_STATUS_CHANNEL_ID=
MODE=DEV

# --- OIDC single sign-on for the admin UI (optional) ---
# Inert unless all three of ISSUER / CLIENT_ID / CLIENT_SECRET are set.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must exactly match the redirect URI registered at the provider.
OIDC_REDIRECT_URL=http://localhost:8005/auth/oidc/callback
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPES=openid profile email
# Restrict who may log in. If ALL are empty, any user your provider
# authenticates becomes a full admin of this panel.
OIDC_ALLOWED_GROUPS=
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_SUBS=
OIDC_GROUPS_CLAIM=groups
OIDC_USERNAME_CLAIM=preferred_username
# Only enable after confirming SSO works, or you will lock yourself out.
OIDC_DISABLE_PASSWORD_LOGIN=0
